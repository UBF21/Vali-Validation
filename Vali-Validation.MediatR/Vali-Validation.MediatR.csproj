<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>Vali_Validation.MediatR</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Package identity -->
        <PackageId>Vali-Validation.MediatR</PackageId>
        <Version>1.1.0</Version>
        <Title>Vali-Validation.MediatR</Title>
        <Product>Vali-Validation.MediatR</Product>
        <Authors>Felipe Rafael Montenegro Morriberon</Authors>
        <Copyright>Copyright © 2025 - FM. All rights reserved.</Copyright>

        <!-- Repository -->
        <RepositoryUrl>https://github.com/UBF21/Vali-Validation</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://vali-validation-docs.netlify.app/docs/mediatr-integration</PackageProjectUrl>

        <!-- License -->
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Source Link / Symbols -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Discoverability -->
        <PackageTags>validation;fluent;mediatr;pipeline;behavior;dotnet;vali;cqrs</PackageTags>
        <PackageIcon>VV.png</PackageIcon>

        <Description>
            MediatR integration for Vali-Validation. Targets net7.0/net8.0/net9.0/net10.0. Adds a
            ValidationBehavior&lt;TRequest, TResponse&gt; pipeline behavior that automatically
            validates IRequest objects using Vali-Validation before they reach their handler.
            Throws ValidationException on failure. Pinned to MediatR 12.4.1 (the last fully
            Apache-licensed release) so installing this package never pulls in MediatR's
            commercial license requirement. Use Vali-Validation.ValiMediator instead if you use
            Vali-Mediator — it provides richer integration with Result&lt;T&gt; support (no
            exceptions needed) and stays free.
        </Description>

        <PackageReleaseNotes>
            v1.1.0
            - Adds net10.0 to the multi-targeted frameworks (now net7.0/net8.0/net9.0/net10.0).
            - Now depends on Vali-Validation 3.0.0+, which brings Severity-aware ValidationResult,
              RuleSets, block-level When/Unless, InjectValidator, Localization (English/Spanish
              built in), ValiValidationOptions.Global, and PropertyValidator to any validator run
              through this pipeline behavior. No changes to this package's own public API.

            v1.0.0 — Initial release.
            - ValidationBehavior&lt;TRequest, TResponse&gt; implementing MediatR IPipelineBehavior.
            - Validates request via IValidator&lt;TRequest&gt; resolved from DI.
            - Throws ValidationException if validation fails (use Vali-Mediator.Validation for Result-based flow).
            - AddMediatRWithValidation() convenience extension for one-call registration.
            - AddValiValidationBehavior() for manual MediatR setup.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="VV.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vali-Validation\Vali-Validation.csproj" />
        <!--
          Deliberately pinned — do not bump. MediatR 13.0.0+ moved to a dual commercial/OSS
          license requiring a LicenseKey; 12.4.1 is the last fully Apache-licensed release.
          This package exists purely for compatibility with existing MediatR users; anyone
          starting fresh should use Vali-Validation.ValiMediator (this project's own free,
          Apache-2.0 mediator) instead. Upgrading this pin would force every consumer of this
          Apache-2.0 package into MediatR's commercial license terms transitively.
        -->
        <PackageReference Include="MediatR" Version="12.4.1" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>

</Project>
